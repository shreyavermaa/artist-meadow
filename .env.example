# Copy to ".env" and fill in. Never commit the real .env.

# --- Supabase (Project Settings -> API) ---
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
# Secret! Only used server-side by the admin. Never PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# --- Admin (the /manage panel) ---
ADMIN_PASSWORD=choose-a-strong-password

# --- Cloudinary (artist images) ---
PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset