---
import Base from './Base.astro';
import Garden from '../components/Garden.astro';
import FallingLeaves from '../components/FallingLeaves.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Back from '../components/Back.astro';
import site from '../data/site.json';
const { title, description } = Astro.props as { title?: string; description?: string };
---
<Base title={title} description={description}>
  <div class="page">
    <Garden />
    <FallingLeaves />
    <div class="wrap">
      <Header brand={site.brand} nav={site.nav} />
      <Back />
      <slot />
      <Footer brand={site.brand} footer={site.footer} />
    </div>
  </div>
</Base>
