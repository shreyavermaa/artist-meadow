---
// Gentle drifting leaves over the whole page (like galleryofshreya).
// Each has its own --peak opacity so they feel layered (some faint & far, some near).
const leaves = [
  'left:4%;width:22px;color:#9DB593;--peak:0.7;animation-duration:15s;animation-delay:-1s',
  'left:10%;width:15px;color:#EBB1C0;--peak:0.35;animation-duration:12s;animation-delay:-5s',
  'left:16%;width:27px;color:#8fb083;--peak:0.85;animation-duration:18s;animation-delay:-9s',
  'left:22%;width:17px;color:#CBB27E;--peak:0.45;animation-duration:14s;animation-delay:-3s',
  'left:28%;width:20px;color:#9DB593;--peak:0.6;animation-duration:16s;animation-delay:-11s',
  'left:34%;width:14px;color:#EBB1C0;--peak:0.3;animation-duration:13s;animation-delay:-6s',
  'left:40%;width:25px;color:#8fb083;--peak:0.8;animation-duration:19s;animation-delay:-2s',
  'left:46%;width:18px;color:#9DB593;--peak:0.5;animation-duration:15s;animation-delay:-13s',
  'left:52%;width:16px;color:#CBB27E;--peak:0.4;animation-duration:12.5s;animation-delay:-7s',
  'left:58%;width:23px;color:#8fb083;--peak:0.72;animation-duration:17s;animation-delay:-4s',
  'left:64%;width:15px;color:#EBB1C0;--peak:0.32;animation-duration:14.5s;animation-delay:-10s',
  'left:70%;width:26px;color:#9DB593;--peak:0.85;animation-duration:20s;animation-delay:-1.5s',
  'left:76%;width:16px;color:#8fb083;--peak:0.45;animation-duration:13.5s;animation-delay:-8s',
  'left:82%;width:21px;color:#CBB27E;--peak:0.62;animation-duration:16.5s;animation-delay:-5.5s',
  'left:88%;width:14px;color:#EBB1C0;--peak:0.3;animation-duration:12s;animation-delay:-12s',
  'left:93%;width:24px;color:#9DB593;--peak:0.78;animation-duration:18.5s;animation-delay:-3.5s',
  'left:97%;width:16px;color:#8fb083;--peak:0.5;animation-duration:15.5s;animation-delay:-9.5s',
];
---
<div class="fall" aria-hidden="true">
  {leaves.map((s) => (
    <svg class="fleaf" style={s} viewBox="0 0 40 40"><use href="#leaf" /></svg>
  ))}
</div>
