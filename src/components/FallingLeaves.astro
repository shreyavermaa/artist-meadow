---
// Gentle drifting leaves over the whole page (like galleryofshreya).
const leaves = [
  'left:4%;width:22px;color:#9DB593;animation-duration:15s;animation-delay:-1s',
  'left:10%;width:16px;color:#EBB1C0;animation-duration:12s;animation-delay:-5s',
  'left:16%;width:26px;color:#8fb083;animation-duration:18s;animation-delay:-9s',
  'left:22%;width:18px;color:#CBB27E;animation-duration:14s;animation-delay:-3s',
  'left:28%;width:20px;color:#9DB593;animation-duration:16s;animation-delay:-11s',
  'left:34%;width:15px;color:#EBB1C0;animation-duration:13s;animation-delay:-6s',
  'left:40%;width:24px;color:#8fb083;animation-duration:19s;animation-delay:-2s',
  'left:46%;width:18px;color:#9DB593;animation-duration:15s;animation-delay:-13s',
  'left:52%;width:16px;color:#CBB27E;animation-duration:12.5s;animation-delay:-7s',
  'left:58%;width:22px;color:#8fb083;animation-duration:17s;animation-delay:-4s',
  'left:64%;width:19px;color:#EBB1C0;animation-duration:14.5s;animation-delay:-10s',
  'left:70%;width:24px;color:#9DB593;animation-duration:20s;animation-delay:-1.5s',
  'left:76%;width:15px;color:#8fb083;animation-duration:13.5s;animation-delay:-8s',
  'left:82%;width:20px;color:#CBB27E;animation-duration:16.5s;animation-delay:-5.5s',
  'left:88%;width:17px;color:#EBB1C0;animation-duration:12s;animation-delay:-12s',
  'left:93%;width:23px;color:#9DB593;animation-duration:18.5s;animation-delay:-3.5s',
  'left:97%;width:16px;color:#8fb083;animation-duration:15.5s;animation-delay:-9.5s',
];
---
<div class="fall" aria-hidden="true">
  {leaves.map((s) => (
    <svg class="fleaf" style={s} viewBox="0 0 40 40"><use href="#leaf" /></svg>
  ))}
</div>
