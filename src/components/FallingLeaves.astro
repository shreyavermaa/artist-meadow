---
// Gentle drifting leaves over the whole page (like galleryofshreya).
const leaves = [
  'left:6%;width:20px;color:#9DB593;animation-duration:17s;animation-delay:-1s',
  'left:16%;width:26px;color:#8fb083;animation-duration:21s;animation-delay:-8s',
  'left:27%;width:16px;color:#EBB1C0;animation-duration:15s;animation-delay:-4s',
  'left:38%;width:22px;color:#9DB593;animation-duration:19s;animation-delay:-12s',
  'left:49%;width:18px;color:#CBB27E;animation-duration:16s;animation-delay:-6s',
  'left:60%;width:24px;color:#8fb083;animation-duration:22s;animation-delay:-3s',
  'left:71%;width:15px;color:#EBB1C0;animation-duration:18s;animation-delay:-10s',
  'left:82%;width:22px;color:#9DB593;animation-duration:20s;animation-delay:-5s',
  'left:92%;width:17px;color:#8fb083;animation-duration:16.5s;animation-delay:-14s',
];
---
<div class="fall" aria-hidden="true">
  {leaves.map((s) => (
    <svg class="fleaf" style={s} viewBox="0 0 40 40"><use href="#leaf" /></svg>
  ))}
</div>
